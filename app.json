{
  "expo": {
    "name": "My Music",
    "slug": "my-music",
    "version": "4.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mukx",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.keshu.wave",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "mukx",
              "host": "play"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "ed50b364-d6bb-444b-81c3-e1a1db4b4275"
      }
    },
    "owner": "cashewww"
  }
}
